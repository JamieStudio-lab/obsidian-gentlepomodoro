    "@rollup/plugin-url": "^8.0.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.4.16",
    "prettier": "^3.3.0",
    "rollup": "^4.18.0",
